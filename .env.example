# Varden environment variables
# Add these to Vercel → Settings → Environment Variables
# This file is a template in a public repo: never put a real value here.

SUPABASE_URL=https://ljruzruhbqkbxkflrvzi.supabase.co
SUPABASE_ANON=your-supabase-anon-key
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token
BLOB_STORE_ID=your-vercel-blob-store-id

# The browser build does not read these; the static site ships the public anon key
# in shared.js and app.js, where row-level security is what protects the data.
